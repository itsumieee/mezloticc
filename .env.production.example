APP_NAME="Roblox Account Checker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://checker.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_STACK=daily
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roblox_checker
DB_USERNAME=roblox_app
DB_PASSWORD=

CACHE_STORE=redis
CACHE_PREFIX=rbx_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=rbx_
REDIS_QUEUE_RETRY_AFTER=360

ROBLOX_API_TIMEOUT=10
ROBLOX_API_RETRY=2
ROBLOX_API_RETRY_DELAY=500

# Set only to the actual trusted proxy IPs/CIDRs when running behind a proxy.
# Do not use '*' unless the origin is firewalled to trusted proxies only.
TRUSTED_PROXIES=